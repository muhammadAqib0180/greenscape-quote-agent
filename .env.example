# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Google Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key

# Slack Incoming Webhook (api.slack.com/apps -> Incoming Webhooks -> Add to Slack)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Dollar threshold above which a 3D render is required before sending to client
RENDER_THRESHOLD=30000

# Application environment: "production" | "test"
# Set to "test" to activate the in-memory fake database (no Supabase credentials required)
APP_ENV=production

# Port the uvicorn server listens on (default: 8000)
PORT=8000
